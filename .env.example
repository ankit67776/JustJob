# Copy to .env and fill in what you use. Everything is optional: without keys the tool still
# runs on the free sources (company boards, Remotive, Remote OK, HN) with rule-based ranking.

# AI step (any one is enough; see [ai] in config.toml)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
GROQ_API_KEY=            # https://console.groq.com/keys
OPENROUTER_API_KEY=

# Extra job sources
JSEARCH_API_KEY=         # RapidAPI key with the JSearch API subscribed (free plan)
ADZUNA_APP_ID=           # https://developer.adzuna.com/
ADZUNA_APP_KEY=

# Telegram digest: create a bot with @BotFather, message it once, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email digest (for Gmail use an App Password, host smtp.gmail.com, port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
